#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Download the sasso native library.
 *
 * Works without the Composer plugin (root package checkout, --no-plugins, CI).
 * When shyim/sasso-ffi is installed as a dependency with plugins allowed,
 * `composer sasso:install` is equivalent.
 */

$autoloadCandidates = [
    dirname(__DIR__) . '/vendor/autoload.php',
    dirname(__DIR__, 3) . '/autoload.php', // vendor/shyim/sasso-ffi/bin → vendor/autoload.php
    dirname(__DIR__, 2) . '/autoload.php',
];

$autoload = null;
foreach ($autoloadCandidates as $candidate) {
    if (is_file($candidate)) {
        $autoload = $candidate;
        break;
    }
}

if ($autoload === null) {
    fwrite(STDERR, "sasso-install: could not find Composer's autoload.php.\n");
    exit(1);
}

require $autoload;

use Sasso\Composer\BinaryInstaller;
use Sasso\Exception as SassoException;

$targets = [];
$force = false;

$args = array_slice($argv, 1);
for ($i = 0, $n = count($args); $i < $n; $i++) {
    $arg = $args[$i];

    if ($arg === '--force' || $arg === '-f') {
        $force = true;
        continue;
    }

    if ($arg === '--target' || $arg === '-t') {
        $value = $args[++$i] ?? null;
        if ($value === null || str_starts_with($value, '-')) {
            fwrite(STDERR, "sasso-install: --target requires a value (or \"all\").\n");
            exit(1);
        }
        $targets[] = $value;
        continue;
    }

    if (str_starts_with($arg, '--target=')) {
        $targets[] = substr($arg, 9);
        continue;
    }

    if ($arg === '--help' || $arg === '-h') {
        echo <<<HELP
Usage: sasso-install [options]

Options:
  -t, --target <triple>  Target triple to fetch (repeatable), or "all"
  -f, --force            Re-download even if already installed
  -h, --help             Show this help

Examples:
  sasso-install
  sasso-install --target=x86_64-unknown-linux-gnu
  sasso-install --target=all --force

HELP;
        exit(0);
    }

    fwrite(STDERR, "sasso-install: unknown argument \"{$arg}\". Try --help.\n");
    exit(1);
}

try {
    $installer = new BinaryInstaller(static function (string $message): void {
        fwrite(STDOUT, 'sasso: ' . $message . PHP_EOL);
    });
    $installer->install($targets, $force);
} catch (SassoException $e) {
    fwrite(STDERR, 'sasso: ' . $e->getMessage() . PHP_EOL);
    exit(1);
}
